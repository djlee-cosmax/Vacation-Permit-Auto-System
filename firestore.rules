rules_version = '2';

// ============================================================
// 휴가증 자동 반영 프로그램 — Firestore 보안 규칙
//
// ⚠️ 배포 시점 주의
//   이 규칙은 "모든 작업자가 Firebase Auth 계정으로 이관된 뒤" 배포해야 한다.
//   먼저 배포하면 아직 이관되지 않은 작업자가 로그인하지 못한다.
//
//   확인 방법: GitHub Actions → [계정 관리] → action=status 실행
//              "전원 이관 완료" 메시지가 나오면 배포 가능.
//
// 배포 후에는 Firebase Console → Authentication → Sign-in method 에서
// "익명" 로그인을 사용 중지해야 익명 접근 경로가 완전히 닫힌다.
//
// 역할은 Custom Claims 로 부여한다 (scripts/auth-admin.js, action=claims).
//   role=admin  이동준
//   role=leader 김가영 (서무)
//   그 외       일반 작업자 (클레임 없음)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 헬퍼 ----------
    function signedIn() {
      // 익명 계정은 사용자로 인정하지 않는다.
      // (이관 이전의 익명 인증만으로 전 직원 정보가 읽히던 것이 문제의 핵심)
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', 'worker') : '';
    }

    function isAdmin()  { return role() == 'admin'; }
    function isStaff()  { return role() == 'admin' || role() == 'leader'; }

    // 로그인한 본인의 사번 (이메일 로컬파트 = 사번)
    function myEmpId() {
      return signedIn() ? request.auth.token.email.split('@')[0] : '';
    }

    // ---------- users : 사번별 잔여 휴가 ----------
    // 비밀번호·보안답변은 Firebase Auth 로 이관되어 더 이상 여기 없다.
    match /users/{empId} {
      // 본인 문서는 본인이, 전체 조회는 서무·관리자만
      allow get:  if signedIn() && (empId == myEmpId() || isStaff());
      allow list: if isStaff();

      // 잔여 휴가 차감·복원은 서무·관리자만.
      // 본인은 이관 표시 등 인증 관련 필드만 스스로 정리할 수 있다.
      allow create, update: if isStaff()
        || (signedIn() && empId == myEmpId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['authMigrated', 'authMigratedAt', 'password',
                           'securityQuestion', 'securityAnswer', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ---------- workers : 작업자 명단 (이름·사번·부서·휴대폰) ----------
    // 개인정보이므로 명단 전체 조회는 서무·관리자로 제한한다.
    match /workers/{docId} {
      allow get:  if signedIn();
      allow list: if isStaff();
      allow write: if isStaff();
    }

    // ---------- leaves : 휴가증 ----------
    // 이름·사번·휴대폰·휴가 사유가 들어 있다. 일반 작업자는 본인 것만.
    //
    // 앱 쿼리를 전부 employeeId 기준으로 바꾼 뒤 조였다(2026-08-25).
    //   중복 확인      where('employeeId','==',내 사번)   ← submitterPhone4 였다
    //   처리완료 정리   where('employeeId','==',내 사번)   ← processed 전체였다
    //   내 휴가증      where('employeeId','==',내 사번)   ← name 이었다
    //   삭제 감시      작업자는 본인 것만 구독 / 서무·관리자는 전체
    //
    // list 는 문서마다 규칙이 평가되므로, 본인 것만 거는 쿼리라야 통과한다.
    // 조건 없이 전체를 훑으면 남의 문서에서 걸려 쿼리 전체가 실패한다 —
    // 그게 노린 것이다.
    match /leaves/{leaveId} {
      function myLeave() {
        return signedIn() && resource.data.employeeId == myEmpId();
      }
      allow read: if isStaff() || myLeave();

      // 남의 이름으로 써 넣지 못하게 한다.
      allow create: if isStaff()
        || (signedIn() && request.resource.data.employeeId == myEmpId());

      // 서무는 처리완료·차감 표시, 본인은 재전송(set) 정도.
      // 소유자를 남에게 넘기는 것은 막는다.
      allow update: if isStaff()
        || (myLeave() && request.resource.data.employeeId == myEmpId());

      // 본인 취소를 허용한다. 예전에는 isStaff() 만이라 작업자가 [내 휴가증]
      // 에서 취소를 눌러도 권한 오류가 났다 — 매뉴얼과 동작이 달랐다.
      allow delete: if isStaff() || myLeave();
    }

    // ---------- system : 자동화 상태 (생휴 리셋 기록 등) ----------
    // 서버(Admin SDK)만 쓰고, 앱은 읽기만 한다.
    match /system/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------- balanceLogs : 잔여 변경 이력 ----------
    match /balanceLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
